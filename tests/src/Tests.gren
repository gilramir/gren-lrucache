module Tests exposing (..)

import Expect exposing (Expectation)
import Test exposing (..)
import Dict

import LRUCache
import Math

suite : Test
suite =
    describe "Cache tests"
        [ describe "Basics"

            [ test "Putting without eviction works" <|
                \_ ->
                    let
                        expected =
                            Dict.empty
                                |> Dict.set "a" 1
                                |> Dict.set "b" 2
                                |> Dict.set "c" 3
                                |> Dict.set "d" 4
                                |> Dict.set "e" 5

                        actual =
                            LRUCache.newLRUCache 10
                                |> LRUCache.put "a" 1
                                |> LRUCache.put "b" 2
                                |> LRUCache.put "c" 3
                                |> LRUCache.put "d" 4
                                |> LRUCache.put "e" 5
                                |> LRUCache.toDict
                    in
                        Expect.equalDicts expected actual

            , test "Putting and eviction works" <|
                \_ ->
                    let
                        expected =
                            Dict.empty
                                |> Dict.set "b" 2
                                |> Dict.set "c" 3
                                |> Dict.set "d" 4
                                |> Dict.set "e" 5

                        actual =
                            LRUCache.newLRUCache 4
                                |> LRUCache.put "a" 1
                                |> LRUCache.put "b" 2
                                |> LRUCache.put "c" 3
                                |> LRUCache.put "d" 4
                                |> LRUCache.put "e" 5
                                |> LRUCache.toDict
                    in
                        Expect.equalDicts expected actual

            , test "Getting works" <|
                \_ ->
                    let
                        expected =
                            Just 2

                        { cache = _, value = actual } =
                            LRUCache.newLRUCache 4
                                |> LRUCache.put "a" 1
                                |> LRUCache.put "b" 2
                                |> LRUCache.put "c" 3
                                |> LRUCache.put "d" 4
                                |> LRUCache.put "e" 5
                                |> LRUCache.get "b"
                    in
                        Expect.equal expected actual

            , test "Getting int key works" <|
                \_ ->
                    let
                        expected =
                            Just 2

                        { cache = _, value = actual } =
                            LRUCache.newLRUCache 4
                                |> LRUCache.put 10 1
                                |> LRUCache.put 20 2
                                |> LRUCache.put 30 3
                                |> LRUCache.put 40 4
                                |> LRUCache.put 50 5
                                |> LRUCache.get 20
                    in
                        Expect.equal expected actual

            , test "Getting Nothing when key has been evicted" <|
                \_ ->
                    let
                        expected =
                            Nothing

                        { cache = _, value = actual } =
                            LRUCache.newLRUCache 2
                                |> LRUCache.put "a" 1
                                |> LRUCache.put "b" 2
                                |> LRUCache.put "c" 3
                                |> LRUCache.get "a"
                    in
                        Expect.equal expected actual

            , test "Multiple evictions work" <|
                \_ ->
                    let
                        expected =
                            Dict.empty
                                |> Dict.set "d" 4
                                |> Dict.set "e" 5

                        actual =
                            LRUCache.newLRUCache 2
                                |> LRUCache.put "a" 1
                                |> LRUCache.put "b" 2
                                |> LRUCache.put "c" 3
                                |> LRUCache.put "d" 4
                                |> LRUCache.put "e" 5
                                |> LRUCache.toDict
                    in
                        Expect.equalDicts expected actual

            , test "Get bumped to the front and changes lru" <|
                \_ ->
                    let
                        expected =
                            Dict.empty
                                |> Dict.set "a" 1
                                |> Dict.set "d" 4
                                |> Dict.set "e" 5

                        { cache = cache1, value = _} =
                            LRUCache.newLRUCache 3
                                |> LRUCache.put "a" 1
                                |> LRUCache.put "b" 2
                                |> LRUCache.put "c" 3
                                |> LRUCache.get "a"

                        actual =
                            cache1
                                |> LRUCache.put "d" 4
                                |> LRUCache.put "e" 5
                                |> LRUCache.toDict
                    in
                        Expect.equalDicts expected actual

            , test "Putting the same thing takes expected space" <|
                \_ ->
                    let
                        expected =
                            Dict.empty
                                |> Dict.set "a" 1
                                |> Dict.set "b" 2

                        actual =
                            LRUCache.newLRUCache 3
                                |> LRUCache.put "a" 5
                                |> LRUCache.put "a" 4
                                |> LRUCache.put "a" 3
                                |> LRUCache.put "a" 2
                                |> LRUCache.put "a" 1
                                |> LRUCache.put "b" 2
                                |> LRUCache.toDict
                    in
                        Expect.equalDicts expected actual

            , test "Remove an item from the cache" <|
                \_ ->
                    let
                        expected =
                            Dict.empty
                                |> Dict.set "a" 1
                                |> Dict.set "c" 3

                        actual =
                            LRUCache.newLRUCache 3
                                |> LRUCache.put "a" 1
                                |> LRUCache.put "b" 2
                                |> LRUCache.put "c" 3
                                |> LRUCache.remove "b"
                                |> LRUCache.toDict
                    in
                        Expect.equalDicts expected actual

            , test "Remove all items" <|
                \_ ->
                    let
                        expected =
                            Dict.empty
                                |> Dict.set "a" 1

                        actual =
                            LRUCache.newLRUCache 3
                                |> LRUCache.put "a" 1
                                |> LRUCache.put "b" 2
                                |> LRUCache.put "c" 3
                                |> LRUCache.remove "b"
                                |> LRUCache.remove "c"
                                |> LRUCache.remove "a"
                                |> LRUCache.put "a" 1
                                |> LRUCache.toDict
                    in
                        Expect.equalDicts expected actual

            , test "Eviction works after deletions" <|
                \_ ->
                    let
                        expected =
                            Dict.empty
                                |> Dict.set "c" 3
                                |> Dict.set "d" 4

                        actual =
                            LRUCache.newLRUCache 2
                                |> LRUCache.put "a" 1
                                |> LRUCache.put "b" 2
                                |> LRUCache.put "c" 3
                                |> LRUCache.remove "a"
                                |> LRUCache.put "d" 4
                                |> LRUCache.toDict
                    in
                        Expect.equalDicts expected actual

            , test "A cache of size 0 holds nothing" <|
                \_ ->
                    LRUCache.newLRUCache 0
                        |> LRUCache.put "a" 1
                        |> LRUCache.put "b" 2
                        |> LRUCache.toDict
                        |> Expect.equalDicts Dict.empty

            , test "A cache of negative size holds nothing" <|
                \_ ->
                    LRUCache.newLRUCache -3
                        |> LRUCache.put "a" 1
                        |> LRUCache.toDict
                        |> Expect.equalDicts Dict.empty

            , test "Putting a key already there, when full, evicts nothing" <|
                \_ ->
                    let
                        expected =
                            Dict.empty
                                |> Dict.set "a" 1
                                |> Dict.set "b" 20
                    in
                    LRUCache.newLRUCache 2
                        |> LRUCache.put "a" 1
                        |> LRUCache.put "b" 2
                        |> LRUCache.put "b" 20
                        |> LRUCache.toDict
                        |> Expect.equalDicts expected

            , test "Putting a key already there makes it the most recently used" <|
                \_ ->
                    let
                        expected =
                            Dict.empty
                                |> Dict.set "a" 10
                                |> Dict.set "c" 3
                    in
                    LRUCache.newLRUCache 2
                        |> LRUCache.put "a" 1
                        |> LRUCache.put "b" 2
                        |> LRUCache.put "a" 10
                        |> LRUCache.put "c" 3
                        |> LRUCache.toDict
                        |> Expect.equalDicts expected

            , test "Getting a missing key changes nothing" <|
                \_ ->
                    let
                        cache =
                            LRUCache.newLRUCache 2
                                |> LRUCache.put "a" 1

                        { cache = after, value = value } =
                            LRUCache.get "z" cache
                    in
                    Expect.equal
                        { value = Nothing, dict = LRUCache.toDict cache }
                        { value = value, dict = LRUCache.toDict after }

            , test "A cache of size 1 keeps only the last key used" <|
                \_ ->
                    let
                        { cache = afterGet, value = _ } =
                            LRUCache.newLRUCache 1
                                |> LRUCache.put "a" 1
                                |> LRUCache.put "b" 2
                                |> LRUCache.get "b"

                        expected =
                            Dict.empty
                                |> Dict.set "c" 3
                    in
                    afterGet
                        |> LRUCache.put "c" 3
                        |> LRUCache.toDict
                        |> Expect.equalDicts expected
            ]
        , describe "Against a reference model, at every step"
            (Array.map modelTest
                (Array.flatten
                    (Array.map
                        (\size -> Array.map (\mix -> { size = size, mix = mix }) mixes)
                        [ 1, 2, 4, 10 ]
                    )
                )
            )
        ]



-- A REFERENCE MODEL: the keys, most recently used first, with their values.
-- After every operation the cache must answer what the model does, hold the
-- same entries, and hold no more than its size.


type Operation
    = Put { key : Int, value : Int }
    | Get Int
    | Remove Int


{-| How often each operation comes, out of ten, and how many keys there are. -}
type alias Mix =
    { name : String, puts : Int, gets : Int, keys : Int }


mixes : Array Mix
mixes =
    [ { name = "mostly puts", puts = 7, gets = 2, keys = 11 }
    , { name = "mostly gets", puts = 3, gets = 6, keys = 7 }
    , { name = "many removes", puts = 4, gets = 2, keys = 17 }
    ]


operation : Mix -> Int -> Operation
operation mix i =
    let
        key =
            Math.modBy mix.keys (i * i * 31 + i * 17 + i // 3)

        roll =
            Math.modBy 10 (i * 7 + i // 10)
    in
    if roll < mix.puts then
        Put { key = key, value = i }

    else if roll < mix.puts + mix.gets then
        Get key

    else
        Remove key


modelTest : { size : Int, mix : Mix } -> Test
modelTest { size, mix } =
    test ("size " ++ String.fromInt size ++ ", " ++ mix.name) <|
        \_ ->
            let
                start =
                    { cache = LRUCache.newLRUCache size, model = [], failure = Nothing }

                final =
                    Array.foldl (step size) start (Array.initialize 2000 0 (operation mix))
            in
            when final.failure is
                Nothing ->
                    Expect.pass

                Just failure ->
                    Expect.fail failure


type alias Run =
    { cache : LRUCache.LRUCache Int Int
    , model : Array { key : Int, value : Int }
    , failure : Maybe String
    }


step : Int -> Operation -> Run -> Run
step size op run =
    when run.failure is
        Just _ ->
            run

        Nothing ->
            let
                done =
                    apply size op run

                actual =
                    LRUCache.toDict done.run.cache
            in
            if done.answer /= done.modelAnswer then
                { done.run | failure = Just (describeOp op ++ " answered " ++ Debug.toString done.answer ++ ", and the model " ++ Debug.toString done.modelAnswer) }

            else if actual /= modelDict done.run.model then
                { done.run | failure = Just ("after " ++ describeOp op ++ " the cache holds " ++ Debug.toString actual ++ ", and the model " ++ Debug.toString (modelDict done.run.model)) }

            else if Dict.count actual > max 0 size then
                { done.run | failure = Just ("after " ++ describeOp op ++ " the cache holds " ++ String.fromInt (Dict.count actual) ++ " entries") }

            else
                done.run


apply : Int -> Operation -> Run -> { run : Run, answer : Maybe Int, modelAnswer : Maybe Int }
apply size op run =
    let
        without key =
            Array.keepIf (\entry -> entry.key /= key) run.model
    in
    when op is
        Put { key, value } ->
            { run =
                { run
                    | cache = LRUCache.put key value run.cache
                    , model =
                        without key
                            |> Array.pushFirst { key = key, value = value }
                            |> Array.takeFirst (max 0 size)
                }
            , answer = Nothing
            , modelAnswer = Nothing
            }

        Get key ->
            let
                { cache, value } =
                    LRUCache.get key run.cache

                found =
                    Array.findFirst (\entry -> entry.key == key) run.model
                        |> Maybe.map .value
            in
            { run =
                { run
                    | cache = cache
                    , model =
                        when found is
                            Nothing ->
                                run.model

                            Just entry ->
                                Array.pushFirst entry (without key)
                }
            , answer = value
            , modelAnswer = Maybe.map .value found
            }

        Remove key ->
            { run = { run | cache = LRUCache.remove key run.cache, model = without key }
            , answer = Nothing
            , modelAnswer = Nothing
            }


describeOp : Operation -> String
describeOp op =
    when op is
        Put { key, value } ->
            "put " ++ String.fromInt key ++ " " ++ String.fromInt value

        Get key ->
            "get " ++ String.fromInt key

        Remove key ->
            "remove " ++ String.fromInt key


modelDict : Array { key : Int, value : Int } -> Dict.Dict Int Int
modelDict model =
    Array.foldl (\entry dict -> Dict.set entry.key entry.value dict) Dict.empty model
