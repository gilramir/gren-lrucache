module LRUCache exposing (LRUCache, get, newLRUCache, put, remove, toDict)

{-| This module provides a cache for key/value pairs. When the maximum
size is reached, the least-recently-used key/value pair is evicted from the
cache.

Example:

```elm
myCache =
    LRUCache.newLRUCache 3
        |> LRUCache.put "a" 1
        |> LRUCache.put "b" 2
        |> LRUCache.put "c" 3
        |> LRUCache.put "d" 4

-- "a" was evicted
LRUCache.get "a" => {cache: newCacheState, value: Nothing}
LRUCache.get "b" => {cache: newCacheState, value: Just 2}
LRUCache.get "c" => {cache: newCacheState, value: Just 3}
LRUCache.get "d" => {cache: newCacheState, value: Just 4}
```

@docs LRUCache
@docs newLRUCache
@docs toDict
@docs put
@docs get
@docs remove
-}

import Dict exposing (Dict)


{-|
LRUCache is the type which is the actual cache. Create one with newLRUCache

-}
type LRUCache comparable v
    = LRUCache (State comparable v)


{-| Each entry remembers the tick at which it was last used, and `recency`
holds the same keys by that tick, so the least recently used one is
`Dict.first recency`. Only `insert`, `delete` and `evictOldest` change the
two Dicts, and each changes both.

There is no linked list, so there is no pointer that can name a missing key,
and no lookup whose `Nothing` "cannot happen".
-}
type alias State comparable v =
    { maxSize : Int
    , nextTick : Int
    , entries : Dict comparable { value : v, tick : Int }
    , recency : Dict Int comparable
    }


{-|
Create the LRUCache, setting the maximum size. A cache whose maximum size is
0 or less holds nothing.

    newLRUCache 100 ->  LRUCache

Example:
```
import LRUCache exposing (LRUCache)

type alias Model =
    { cache : LRUCache
    }

initialModel =
    { cache = LRUCache.newCache 100
    }
```

-}
newLRUCache : Int -> LRUCache comparable v
newLRUCache maxSize =
    LRUCache
        { maxSize = maxSize
        , nextTick = 0
        , entries = Dict.empty
        , recency = Dict.empty
        }


{-|
Get a Dict that represents this cache, without any history of which keys
were most recently used. This is useful for unit tests.
As a user of the package, you're unlikely to use toDict.

    toDict lruCache -> Dict

-}
toDict : LRUCache comparable v -> Dict comparable v
toDict (LRUCache { entries }) =
    Dict.map (\_ entry -> entry.value) entries


{-|
Insert, or update, a key/value pair. This marks the key as
most recently used.

    put "new-entry" 10 lruCache -> LRUCache

Example:
```
    let
        newCache = LRUCache.put "new-entry" 10 model.cache
    in
        { model
            | cache = newCache
        }
```

-}
put : comparable -> v -> LRUCache comparable v -> LRUCache comparable v
put key value (LRUCache state) =
    if state.maxSize < 1 then
        LRUCache state

    else
        let
            withoutKey =
                delete key state

            withRoom =
                if Dict.count withoutKey.entries < state.maxSize then
                    withoutKey

                else
                    evictOldest withoutKey
        in
        LRUCache (insert key value withRoom)


{-|
Maybe get a value for the given key. If the key exists, it is marked
as most recently used.

    get key lruCache -> { cache: LRUCache, value: Maybe value }

Example:
```
    let
        {cache: newCache, value: maybeValue } = LRUCache.get "new-entry" model.cache
    in
        when maybeValue is
            Nothing ->
                { model
                    | cache = newCache
                }, Cmd.none

            Just value ->
                { model
                    | cache = newCache
                    , results = value
                }, Cmd.none
```

-}
get : comparable -> LRUCache comparable v -> { cache : LRUCache comparable v, value : Maybe v }
get key ((LRUCache state) as cache) =
    when Dict.get key state.entries is
        Nothing ->
            { cache = cache, value = Nothing }

        Just entry ->
            { cache = LRUCache (insert key entry.value (delete key state))
            , value = Just entry.value
            }


{-|
Remove a key from the cache.  If the key doesn't exist, no harm is done.

    remove key lruCache -> LRUCache

Example:
```
    let
        newCache = LRUCache.remove "new-entry" model.cache
    in
        { model
            | cache = newCache
        }
```

-}
remove : comparable -> LRUCache comparable v -> LRUCache comparable v
remove key (LRUCache state) =
    LRUCache (delete key state)


-- THE TWO DICTS, CHANGED TOGETHER


{-| Add a key as the most recently used. `put` and `get` delete it first. -}
insert : comparable -> v -> State comparable v -> State comparable v
insert key value state =
    { state
        | nextTick = state.nextTick + 1
        , entries = Dict.set key { value = value, tick = state.nextTick } state.entries
        , recency = Dict.set state.nextTick key state.recency
    }


{-| Remove a key, if it is there. -}
delete : comparable -> State comparable v -> State comparable v
delete key state =
    when Dict.get key state.entries is
        Nothing ->
            state

        Just entry ->
            { state
                | entries = Dict.remove key state.entries
                , recency = Dict.remove entry.tick state.recency
            }


{-| Remove the least recently used entry, if there is one. An empty cache has
nothing to evict, and leaving it as it is is the right answer, not a case that
"cannot happen".
-}
evictOldest : State comparable v -> State comparable v
evictOldest state =
    when Dict.first state.recency is
        Nothing ->
            state

        Just oldest ->
            { state
                | entries = Dict.remove oldest.value state.entries
                , recency = Dict.remove oldest.key state.recency
            }
